rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isWorldOwner(worldId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/architect_worlds/$(worldId))
        && get(/databases/$(database)/documents/architect_worlds/$(worldId)).data.createdBy == request.auth.uid;
    }

    function isWorldMetadataOwner() {
      return isAuthenticated()
        && resource.data.createdBy == request.auth.uid;
    }

    function preservesGovernedContractMetadata() {
      return ('contractBaselineVersion' in resource.data)
        ? ('contractBaselineVersion' in request.resource.data
          && request.resource.data.contractBaselineVersion == resource.data.contractBaselineVersion
          && request.resource.data.contractSourceRelease == resource.data.contractSourceRelease
          && request.resource.data.contractBaselineEffectiveAt == resource.data.contractBaselineEffectiveAt
          && request.resource.data.contractBaselineSalaryCapYear == resource.data.contractBaselineSalaryCapYear
          && request.resource.data.contractBaselineCoverage == resource.data.contractBaselineCoverage)
        : !('contractBaselineVersion' in request.resource.data);
    }

    function isOpenForClientWorldWrites(worldId) {
      return isWorldOwner(worldId)
        && !('partialBranchCleanupClaim' in get(/databases/$(database)/documents/architect_worlds/$(worldId)).data);
    }

    function preservesPartialBranchCleanupClaim() {
      return !('partialBranchCleanupClaim' in resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'partialBranchCleanupClaim'
        ]);
    }

    // Lists: strict owner-scoped access.
    match /lists/{listId} {
      allow read: if isAuthenticated()
        && resource.data.ownerUid == request.auth.uid;

      allow create: if isAuthenticated()
        && request.resource.data.ownerUid == request.auth.uid;

      allow update: if isAuthenticated()
        && resource.data.ownerUid == request.auth.uid;

      allow delete: if isAuthenticated()
        && resource.data.ownerUid == request.auth.uid;
    }

    // Tier lists: strict owner-scoped access.
    match /tierLists/{tierListId} {
      allow read: if isAuthenticated()
        && resource.data.ownerUid == request.auth.uid;

      allow create: if isAuthenticated()
        && request.resource.data.ownerUid == request.auth.uid;

      allow update: if isAuthenticated()
        && resource.data.ownerUid == request.auth.uid;

      allow delete: if isAuthenticated()
        && resource.data.ownerUid == request.auth.uid;
    }

    // Ranker sessions: strict owner-scoped access.
    match /rankerSessions/{sessionId} {
      allow read: if isAuthenticated()
        && resource.data.ownerUid == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAuthenticated()
        && resource.data.ownerUid == request.auth.uid;
    }

    // Player profile evaluation overlays: user-owned editable scouting data.
    match /playerProfileEvaluations/{ownerUid} {
      allow read, write: if isAuthenticated()
        && ownerUid == request.auth.uid;

      match /players/{playerId} {
        allow read: if isAuthenticated()
          && ownerUid == request.auth.uid;
        allow create: if isAuthenticated()
          && ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.playerId == playerId;
        allow update: if isAuthenticated()
          && ownerUid == request.auth.uid
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.playerId == playerId;
        allow delete: if isAuthenticated()
          && ownerUid == request.auth.uid
          && resource.data.ownerUid == request.auth.uid;
      }
    }

    // Architect worlds: owner-only access based on world.createdBy.
    match /architect_worlds/{worldId} {
      allow get, list: if isWorldMetadataOwner();
      allow create: if false;
      allow update: if isWorldMetadataOwner()
        && request.resource.data.createdBy == resource.data.createdBy
        && preservesGovernedContractMetadata()
        && preservesPartialBranchCleanupClaim();
      allow delete: if false;

      match /teams/{teamCode} {
        allow read: if isWorldOwner(worldId);
        allow write: if isOpenForClientWorldWrites(worldId);

        match /players/{playerId} {
          allow read: if isWorldOwner(worldId);
          allow write: if isOpenForClientWorldWrites(worldId);
        }

        match /freeAgentPools/{seasonKey} {
          allow read: if isWorldOwner(worldId);
          allow write: if isOpenForClientWorldWrites(worldId);
        }
      }

      match /events/{eventId} {
        allow read: if isWorldOwner(worldId);
        allow write: if isOpenForClientWorldWrites(worldId);
      }

      match /entitlements/{entitlementId} {
        allow read: if isWorldOwner(worldId);
        allow write: if isOpenForClientWorldWrites(worldId);
      }

      // Governed roots are created only by initializeArchitectWorld through the
      // Admin SDK. Browsers can read their own shards but can never author them.
      match /contractBaselines/{shardId} {
        allow read: if isWorldOwner(worldId);
        allow create, update, delete: if false;
      }

      // Unknown world subcollections fail closed; supported writable paths are
      // declared above so immutable governed state cannot inherit a broad write.
      match /{document=**} {
        allow read: if isWorldOwner(worldId);
        allow write: if false;
      }
    }

    // Canonical source/base collections: read-only.
    match /players_v2/{playerId} {
      allow read: if isAuthenticated();
      allow write: if false;

      match /contracts/{contractId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }

      match /seasons/{seasonId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }

      match /evaluations/{evaluationId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    match /architect_basePlayers/{playerId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /architect_baseTeams/{teamCode} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /architect_baseEntitlements/{entitlementId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /architect_basePickRules/{ruleId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Root teams remains read-only.
    match /teams/{teamCode} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Preserve existing non-architect utility collections without global-open writes.
    match /rosterProjects/{projectId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /freeAgents/{agentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Explicit fail-closed fallback for all unmatched paths.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
