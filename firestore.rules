rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // BASE COLLECTIONS: Public read-only (Admin SDK only for writes)
    // ─────────────────────────────────────────────────────────────────────────

    // architect_baseTeams: Immutable base team data
    match /architect_baseTeams/{teamCode} {
      allow read: if true;
      allow write: if false;  // Admin SDK only
    }

    // architect_basePlayers: Immutable base player data
    match /architect_basePlayers/{playerId} {
      allow read: if true;
      allow write: if false;  // Admin SDK only
    }

    // ─────────────────────────────────────────────────────────────────────────
    // ARCHITECT WORLDS: Owner-scoped access (requires auth)
    // ─────────────────────────────────────────────────────────────────────────

    match /architect_worlds/{worldId} {

      function worldDocPath() {
        return /databases/$(database)/documents/architect_worlds/$(worldId);
      }

      function isOwner() {
        return request.auth != null
          && resource.data.createdBy == request.auth.uid;
      }

      function willBeOwner() {
        return request.auth != null
          && request.resource.data.createdBy == request.auth.uid;
      }

      // Used by subcollections (teams/players) where "resource" is NOT the world doc.
      function isWorldOwner() {
        return request.auth != null
          && exists(worldDocPath())
          && get(worldDocPath()).data.createdBy == request.auth.uid;
      }

      function validWorld() {
        let data = request.resource.data;
        return data.keys().hasAll(['createdBy', 'worldName', 'createdAt'])
          && data.createdBy is string
          && data.createdBy == request.auth.uid
          && data.worldName is string
          && data.worldName.size() > 0
          && data.worldName.size() <= 100
          && data.createdAt == request.time;
      }

      function validWorldUpdate() {
        let data = request.resource.data;
        return data.createdBy == resource.data.createdBy
          && (!('worldName' in data) || (data.worldName is string && data.worldName.size() > 0 && data.worldName.size() <= 100));
      }

      allow read: if isOwner();
      allow create: if willBeOwner() && validWorld();
      allow update: if isOwner() && validWorldUpdate();
      allow delete: if false;

      // ───────────────────────────────────────────────────────────────────────
      // World subcollections
      // ───────────────────────────────────────────────────────────────────────

      match /teams/{teamCode} {
        allow read: if isWorldOwner();
        allow create, update: if isWorldOwner();
        allow delete: if false;

        match /players/{playerId} {
          allow read: if isWorldOwner();
          allow create, update: if isWorldOwner();
          allow delete: if false;
        }
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // LEGACY: players_v2 public read-only
    // ─────────────────────────────────────────────────────────────────────────

    match /players_v2/{playerId} {
      allow read: if true;
      allow write: if false;

      match /{document=**} {
        allow read: if true;
        allow write: if false;
      }
    }
  }
}
