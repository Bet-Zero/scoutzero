rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // Helpers
    // ─────────────────────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    function validWorldName(name) {
      return name is string && name.size() > 0 && name.size() <= 100;
    }

    // SAFE world-owner check used in subcollections
    // (exists() first, then get() — prevents evaluation crashes)
    function isWorldOwner(worldId) {
      return signedIn()
        && exists(/databases/$(database)/documents/architect_worlds/$(worldId))
        && get(/databases/$(database)/documents/architect_worlds/$(worldId)).data.createdBy == request.auth.uid;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // BASE COLLECTIONS: Public read-only (Admin SDK only for writes)
    // ─────────────────────────────────────────────────────────────────────────
    match /architect_baseTeams/{teamCode} {
      allow read: if true;
      allow write: if false;
    }

    match /architect_basePlayers/{playerId} {
      allow read: if true;
      allow write: if false;
    }

    // Optional: only needed if your app reads free agents from these
    match /architect_baseFreeAgents/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /architect_freeAgents/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // WORLDS: Owner scoped
    // ─────────────────────────────────────────────────────────────────────────
    match /architect_worlds/{worldId} {

      // Read world doc only if you're the owner
      allow read: if signedIn() && resource.data.createdBy == request.auth.uid;

      // Create world doc:
      // - must be signed in
      // - must set createdBy to yourself
      // - must include a valid worldName
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && validWorldName(request.resource.data.worldName);

      // Update world doc:
      // - must be owner
      // - cannot change createdBy
      // - if worldName is present, it must still be valid
      allow update: if signedIn()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy
        && (!('worldName' in request.resource.data) || validWorldName(request.resource.data.worldName));

      allow delete: if false;

      // ───────────────────────────────────────────────────────────────────────
      // ───────────────────────────────────────────────────────────────────────
      // World subcollections
      // ───────────────────────────────────────────────────────────────────────
      match /teams/{teamCode} {
        allow read, create, update: if isWorldOwner(worldId);
        allow delete: if false;

        match /players/{playerId} {
          allow read, create, update: if isWorldOwner(worldId);
          allow delete: if false;
        }
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // LEGACY: players_v2 public read-only
    // ─────────────────────────────────────────────────────────────────────────
    match /players_v2/{playerId} {
      allow read: if true;
      allow write: if false;

      match /{document=**} {
        allow read: if true;
        allow write: if false;
      }
    }
  }
}
