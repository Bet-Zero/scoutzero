              className="block w-full text-left px-3 py-1 hover:bg-[#333]"
            >
              Modify Contract
            </button>

            {/* View Profile Option */}
            <button
              onClick={() =>
                (window.location.href = `/profiles?player=${player.player_id}`)
              }
              className="block w-full text-left px-3 py-1 hover:bg-[#333]"
            >
              View Profile
            </button>
          </div>
        )}
      </div>
    </div>
  );
