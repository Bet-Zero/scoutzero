{
  "name": "scoutzero-functions",
  "version": "0.0.1",
  "description": "Firebase Cloud Functions for ScoutZero",
  "main": "lib/index.js",
  "engines": {
    "node": "18"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc && npm run copy:contract-release",
    "copy:contract-release": "node -e \"const fs=require('node:fs');const dir='lib/architect/assets';fs.mkdirSync(dir,{recursive:true});fs.copyFileSync('../public/architect/contract-source-releases/salaryswish-retained-2026-06-05-v1.json',dir+'/salaryswish-retained-2026-06-05-v1.json')\"",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "test": "vitest --run src"
  },
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^6.3.2"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  },
  "private": true
}
