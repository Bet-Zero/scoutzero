  "bugs": {
    "url": "https://github.com/Bet-Zero/scoutzero/issues"
  },
  "homepage": "https://github.com/Bet-Zero/scoutzero#readme",
  "description": "NBA scouting platform and GM toolkit with trade machine, roster builder, and player evaluation tools",
  "directories": {
    "doc": "docs",
    "test": "tests"
  }
}
