{
  "name": "scoutzero-final2",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "update-stats": "node updateStats.js",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "check:legacy": "node scripts/scan_for_legacy.cjs",
    "docs": "node generateDocs.cjs",
    "test": "vitest",
    "zen": "node toggleView.cjs",
    "prepare": "echo skipped",
    "docs:deps": "node scripts/generate-deps.cjs",
    "docs:candidates": "node scripts/detect-validators.cjs",
    "docs:api": "documentation build \"src/**/*.{js,ts,jsx,tsx}\" -f md -o atlas-docs/api.md --shallow",
    "docs:map": "node scripts/generate-plain-map.cjs",
    "docs:rules": "node scripts/generate-rules-catalog.cjs",
    "docs:mermaid": "node scripts/generate-mermaid.cjs",
    "docs:all": "npm run docs:deps && npm run docs:api && npm run docs:map && npm run docs:candidates && npm run docs:rules && npm run docs:mermaid",
    "map:dups": "node scripts/find-duplicates.cjs",
    "map:suggest": "node scripts/suggest-buckets.cjs",
    "map:all": "npm run map:dups && npm run map:suggest",
    "deps:check": "depcruise src/utils/architect/tradeMachine --config scripts/depcruise.architect.cjs",
    "season:create": "python3 data_pipeline/season_manager.py create",
    "season:archive": "python3 data_pipeline/season_manager.py archive",
    "season:list": "python3 data_pipeline/season_manager.py list",
    "season:transition": "python3 data_pipeline/05_season_transition_streamlined.py",
    "contracts:update": "python3 data_pipeline/updateContracts_enhanced.py",
    "stats:update": "python3 data_pipeline/update_stats.py",
    "capsheets:generate": "node data_pipeline/helpers/capsheets/generateCapSheets.js",
    "data:populate": "node scripts/populate-firestore-data.js",
    "data:populate-main": "node scripts/populate-firestore-data.js --main-only",
    "data:populate-season": "node scripts/populate-firestore-data.js --season",
    "schema:map-generate": "node schema_transition/utils/generate_schema_map_fallback.cjs",
    "schema:test": "node schema_transition/utils/integration_test.cjs",
    "schema:migrate-dry": "MODE=dry-run node schema_transition/core/migrate_full_players.cjs",
    "schema:migrate-shadow": "MODE=shadow SEASON=2025-26 node schema_transition/core/migrate_full_players.cjs",
    "schema:migrate-live": "MODE=live CONFIRM_SHADOW=1 SEASON=2025-26 node schema_transition/core/migrate_full_players.cjs",
    "schema:rollback-dry": "DRY_RUN=1 node schema_transition/utils/rollback_migration.cjs",
    "schema:rollback-live": "DRY_RUN=0 node schema_transition/utils/rollback_migration.cjs",
    "schema:orchestrate": "node schema_transition/schema_transition_orchestrator.cjs",
    "migrate:dry": "node scripts/migrate_phase1_enhanced.cjs --dry-run",
    "migrate:shadow": "node scripts/migrate_phase1_enhanced.cjs --shadow",
    "migrate:shadow-backup": "node scripts/migrate_phase1_enhanced.cjs --shadow --backup",
    "migrate:live": "node scripts/migrate_phase1_enhanced.cjs --backup",
    "migrate:rollback": "node scripts/rollback_migration.cjs",
    "migrate:rollback-confirm": "node scripts/rollback_migration.cjs --confirm",
    "migrate:rename": "node scripts/rename_collection.cjs",
    "migrate:rename-confirm": "node scripts/rename_collection.cjs --confirm",
    "fetch": "tsx team-scrape/scripts/fetch_page.ts",
    "probe": "tsx team-scrape/scripts/probe.ts",
    "parse": "tsx team-scrape/scripts/parse_team.ts",
    "inspect": "tsx team-scrape/scripts/inspect.ts",
    "merge:samples": "tsx team-scrape/review_and_merge/scripts/merge_team_outputs.ts",
    "fetch-player": "npx tsx player-scrape/fetch_player_page.ts",
    "parse-player": "npx tsx player-scrape/parse_player.ts",
    "validate-player": "npx tsx player-scrape/validate_player.ts",
    "batch-scrape-players": "npx tsx player-scrape/batch_scrape_players.ts",
    "realgm:drafts": "tsx team-scrape/scripts/realgm_draft_picks.ts"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.6",
    "@heroicons/react": "^2.2.0",
    "clsx": "^2.1.1",
    "csv-parser": "^3.2.0",
    "date-fns": "^4.1.0",
    "firebase": "^11.6.1",
    "firebase-admin": "^13.5.0",
    "framer-motion": "^12.23.9",
    "got": "^14.5.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^0.503.0",
    "puppeteer": "^24.23.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.5.2",
    "react-router-dom": "^7.6.0",
    "react-window": "^1.8.11",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/react": "^14.2.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "c8": "^10.1.3",
    "cheerio": "^1.1.2",
    "dependency-cruiser": "^17.0.1",
    "documentation": "^14.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-formatter-table": "^7.32.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "glob": "^11.0.3",
    "husky": "^9.1.7",
    "jsdoc-to-markdown": "^9.1.2",
    "jsdom": "^26.1.0",
    "madge": "^8.0.0",
    "playwright": "^1.56.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "sharp": "^0.34.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "vite": "^4.4.0",
    "vitest": "^1.6.1"
  },
  "main": "postcss.config.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bet-Zero/scoutzero.git"
