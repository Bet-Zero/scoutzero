{
  "name": "scoutzero",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "validate:project": "tsx scripts/validate-project-schema.ts",
    "scrape:one": "tsx player-scrape/contracts/scripts/run_contracts.ts",
    "regress": "tsx player-scrape/contracts/scripts/_dev/run_regress.ts",
    "regress:stats": "tsx player-scrape/stats/scripts/_dev/run_regress.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:md": "markdownlint 'docs/**/*.md' '*.md' --ignore node_modules --ignore copilot-instructions.md --ignore 'docs/return-packages/**'",
    "schema:generate": "tsx scripts/generate-schemas.ts",
    "schema:check": "npm run schema:generate && git diff --quiet -- docs/schema || (echo 'Schema outputs are out of date. Run npm run schema:generate' && exit 1)",
    "docs": "node scripts/generateDocs.cjs",
    "test": "vitest run -c vitest.node.config.js && vitest run -c vitest.ui.config.js",
    "test:fast": "vitest run tests/smoke",
    "test:node": "vitest run -c vitest.node.config.js",
    "test:ui": "vitest run -c vitest.ui.config.js",
    "test:full": "vitest run -c vitest.node.config.js && vitest run -c vitest.ui.config.js",
    "test:profile": "node scripts/analyze-test-performance.mjs",
    "test:architect": "vitest run -c vitest.node.config.js tests/architect src/tests/architect src/tests/tradeMachine",
    "test:trade": "vitest run -c vitest.node.config.js tests/trade",
    "test:roster": "vitest run -c vitest.node.config.js src/tests/roster",
    "test:scouting": "vitest run -c vitest.node.config.js src/tests/scouting",
    "test:diff": "node scripts/run-tests-by-diff.mjs",
    "zen": "node scripts/toggleView.cjs",
    "fetch": "tsx team-scrape/team-data/scripts/fetch_page.ts",
    "probe": "tsx team-scrape/team-data/scripts/probe.ts",
    "parse": "tsx team-scrape/team-data/scripts/parse_team.ts",
    "inspect": "tsx team-scrape/team-data/scripts/inspect.ts",
    "merge:samples": "tsx team-scrape/shared/review_and_merge/scripts/merge_team_outputs.ts",
    "clean-view": "npx tsx team-scrape/shared/review_and_merge/scripts/create_clean_view.ts",
    "stage:team": "tsx team-scrape/shared/firestore_staging/scripts/stage_team.ts",
    "team:salaryswish": "tsx team-scrape/shared/firestore_staging/scripts/run_full_team_scrape.ts",
    "team:draft-picks": "tsx team-scrape/draft-picks/scripts/realgm_draft_picks.ts --outDir team-scrape/draft-picks/_artifacts/output",
    "draft-picks:scrape": "npm run team:draft-picks -- --outDir team-scrape/draft-picks/_artifacts/output/mentions",
    "draft-picks:build": "npx tsx team-scrape/shared/ledger/buildPickLedger.ts --input=mentions --inputDir team-scrape/draft-picks/_artifacts/output/mentions && npx tsx team-scrape/shared/ledger/buildDraftAssets.ts",
    "draft-picks:assets-md": "npx tsx team-scrape/draft-picks/scripts/generate_draft_assets_md.ts",
    "draft-picks:assets-manual-check": "npx tsx team-scrape/draft-picks/scripts/generate_draft_assets_manual_check_md.ts",
    "draft-picks:reports": "npx tsx team-scrape/draft-picks/scripts/generate_ledger_tsv.ts && npx tsx team-scrape/draft-picks/scripts/generate_ledger_md.ts && npx tsx team-scrape/draft-picks/scripts/generate_draft_assets_md.ts && npx tsx team-scrape/draft-picks/scripts/generate_draft_assets_manual_check_md.ts",
    "draft-picks:audits": "npx tsx team-scrape/draft-picks/scripts/audit_mentions_year_coverage.ts --mentionsDir=team-scrape/draft-picks/_artifacts/output/mentions && npx tsx team-scrape/draft-picks/scripts/audit_semantic_assertions.ts --teams=ALL --mentionsDir=team-scrape/draft-picks/_artifacts/output/mentions && npx tsx team-scrape/draft-picks/scripts/audit_recipient_inventory_invariant.ts --mentionsDir team-scrape/draft-picks/_artifacts/output/mentions --ledgerDir team-scrape/shared/firestore_staging/_artifacts/output/ledger/by_team && npx tsx team-scrape/draft-picks/scripts/audit_draft_assets_invariant.ts",
    "draft-picks:verify": "npm run draft-picks:build && npm run draft-picks:reports && npm run draft-picks:audits",
    "draft-picks:scrape-verify": "npm run draft-picks:scrape && npm run draft-picks:verify",
    "team:full": "tsx team-scrape/shared/firestore_staging/scripts/run_team_pipeline.ts",
    "team:push": "tsx team-scrape/shared/firestore_staging/scripts/push_staged_teams.ts",
    "team:publish": "npm run stage:team && npm run team:push",
    "fetch-player": "npx tsx player-scrape/contracts/scripts/fetch_player_page.ts",
    "parse-player": "tsx player-scrape/contracts/scripts/parse_player.ts",
    "validate-player": "npx tsx player-scrape/contracts/scripts/validate_player.ts",
    "validate-po-voiding": "npx tsx player-scrape/contracts/scripts/_dev/validate_po_voiding.ts",
    "stats:batch": "tsx player-scrape/stats/scripts/run_stats_batch.ts",
    "contracts:run": "tsx player-scrape/contracts/scripts/run_contracts.ts",
    "contracts:team": "tsx player-scrape/contracts/scripts/run_contracts.ts --team=LAL --concurrency=6 --resume",
    "contracts:one": "tsx player-scrape/contracts/scripts/run_contracts.ts --player=austin_reaves --resume",
    "contracts:push": "tsx player-scrape/contracts/scripts/run_contracts.ts --push --resume",
    "build-player-index": "npx tsx player-scrape/shared/scripts/build_player_index.ts",
    "realgm:drafts": "tsx team-scrape/draft-picks/scripts/realgm_draft_picks.ts",
    "peek:ids": "node -e \"const p=require('./player-scrape/shared/outputs/all_player_ids.json'); console.log(Object.keys(p).length)\"",
    "peek:has": "node -e \"const p=require('./player-scrape/shared/outputs/all_player_ids.json'); const ids=(process.env.IDS||'').split(',').map(x=>+x).filter(Boolean); for (const id of ids){let key=null; for(const [k,v] of Object.entries(p)) if(v===id){key=k;break} console.log(id,Boolean(key),key||'')}\"",
    "peek:unresolved": "node -e \"console.log(JSON.stringify(require('./player-scrape/shared/reports/unresolved_names.json'),null,2))\"",
    "peek:dupes": "node -e \"console.log(JSON.stringify(require('./player-scrape/shared/reports/dupe_name_candidates.json'),null,2))\"",
    "peek:filtered": "node -e \"console.log(JSON.stringify(require('./player-scrape/shared/reports/filtered_out.json'),null,2))\"",
    "build:ids": "tsx player-scrape/shared/scripts/build_all_player_ids.ts --season=2026",
    "build:bios": "tsx player-scrape/shared/scripts/build_players_bios.ts --season=2026",
    "build:index": "tsx player-scrape/shared/scripts/build_player_index.ts --season=2026",
    "build:foundation": "npm run build:ids && npm run build:bios && npm run build:index",
    "firestore:architect:scan": "node scripts/firebase-utils/scan-architect-usage.js",
    "firestore:architect:snapshot": "node scripts/firebase-utils/export-sanitized-snapshot.js",
    "emu": "npx tsx scripts/emu/runEmu.ts",
    "emu:save": "firebase emulators:export --project scoutzero-bf1ae ./.emulator-data --force",
    "emu:clear": "rm -rf ./.emulator-data && mkdir -p ./.emulator-data",
    "emu:seed:base-players": "npx tsx scripts/emu/seedPlayersIfMissing.ts --collection=architect_basePlayers",
    "emu:seed:players-v2": "npx tsx scripts/emu/seedPlayersIfMissing.ts --collection=players_v2",
    "emu:reseed:entitlements": "npx tsx scripts/emu/reseedEntitlements.ts",
    "emu:reseed:baseTeams": "npx tsx scripts/emu/reseedBaseTeams.ts",
    "emu:repair:teams": "npx tsx scripts/emu/repairTeams.ts",
    "emu:doctor": "npx tsx scripts/emu/doctor.ts",
    "verify:artifacts:players": "npx tsx scripts/emu/verifyArtifactsPlayersV2.ts",
    "verify:artifacts:baseTeams": "npx tsx scripts/emu/verifyArtifactsBaseTeams.ts",
    "stage:patch:baseTeams:entitlementIds": "npx tsx team-scrape/shared/firestore_staging/scripts/patch_baseTeams_entitlementIds.ts",
    "stage:patch:baseTeams:entitlementIds:write": "npx tsx team-scrape/shared/firestore_staging/scripts/patch_baseTeams_entitlementIds.ts --write",
    "pst:fetch": "npx tsx team-scrape/draft-picks/scripts/pst/pst_fetch_pages.ts",
    "pst:fetch:headed": "npx tsx team-scrape/draft-picks/scripts/pst/pst_fetch_pages.ts --headed",
    "pst:manual:urls": "npx tsx team-scrape/draft-picks/scripts/pst/pst_manual_fetch_helper.ts --urls",
    "pst:manual:check": "npx tsx team-scrape/draft-picks/scripts/pst/pst_manual_fetch_helper.ts --check",
    "pst:manual:manifest": "npx tsx team-scrape/draft-picks/scripts/pst/pst_manual_fetch_helper.ts --generate-manifest",
    "pst:session:chrome": "npx tsx team-scrape/draft-picks/scripts/pst/launch_chrome_debug_helper.ts",
    "pst:session:capture": "npx tsx team-scrape/draft-picks/scripts/pst/pst_capture_session.ts",
    "pst:session:capture:cdp": "npx tsx team-scrape/draft-picks/scripts/pst/pst_capture_session_cdp.ts",
    "pst:session:test": "npx tsx team-scrape/draft-picks/scripts/pst/pst_fetch_pages_with_session.ts --test",
    "pst:fetch:session": "npx tsx team-scrape/draft-picks/scripts/pst/pst_fetch_pages_with_session.ts",
    "pst:fetch:cdp": "npx tsx team-scrape/draft-picks/scripts/pst/pst_fetch_pages_over_cdp.ts",
    "pst:fetch:cdp:test": "npx tsx team-scrape/draft-picks/scripts/pst/pst_fetch_pages_over_cdp.ts --test",
    "pst:extract": "npx tsx team-scrape/draft-picks/scripts/pst/pst_extract_raw_rows.ts",
    "pst:validate": "npx tsx team-scrape/draft-picks/scripts/pst/pst_validate_phase_1_2.ts",
    "pst:phase-1-2": "npm run pst:fetch:session && npm run pst:extract && npm run pst:validate",
    "pst:phase-1-2:cdp": "npm run pst:fetch:cdp && npm run pst:extract && npm run pst:validate",
    "pst:build:base": "npx tsx team-scrape/draft-picks/scripts/pst/pst_build_base_ledger.ts",
    "pst:build:overlay": "npx tsx team-scrape/draft-picks/scripts/pst/pst_build_owner_overlay.ts",
    "pst:apply:overlay": "npx tsx team-scrape/draft-picks/scripts/pst/pst_apply_display_owner_overlay.ts",
    "pst:build:holdings": "npx tsx team-scrape/draft-picks/scripts/pst/pst_build_holdings_by_team.ts",
    "pst:phase-2": "npm run pst:build:base && npm run pst:build:overlay && npm run pst:apply:overlay && npm run pst:build:holdings",
    "pst:phase-2:validate": "npx tsx team-scrape/draft-picks/scripts/pst/pst_validate_phase_2_ledger.ts",
    "pst:phase-3": "npx tsx team-scrape/draft-picks/scripts/pst/pst_phase_3_normalize_text.ts",
    "pst:phase-4": "npx tsx team-scrape/draft-picks/scripts/pst/pst_phase_4_build_profiles.ts",
    "pst:phase-4:report": "npx tsx team-scrape/draft-picks/scripts/pst/pst_phase_4_build_profiles.ts && cat data/pst/pst_phase_4_report.json",
    "pst:phase-5": "npx tsx team-scrape/draft-picks/scripts/pst/pst_phase_5_finalize.ts",
    "pst:phase-5:validate": "npx tsx team-scrape/draft-picks/scripts/pst/pst_phase_5_finalize.ts",
    "pst:build-final": "npm run pst:apply:overlay && npm run pst:phase-4 && npm run pst:phase-5 && npm run pst:phase-5:validate && npm run pst:manual-views && npm run pst:manual-rights-views",
    "pst:manual-views": "npx tsx team-scrape/draft-picks/scripts/pst/pst_phase_6_manual_check_views.ts --v6-5",
    "pst:manual-views:legacy": "npx tsx team-scrape/draft-picks/scripts/pst/pst_phase_6_manual_check_views.ts",
    "pst:manual-rights-views": "npx tsx team-scrape/draft-picks/scripts/pst/pst_phase_7_rights_views.ts",
    "pst:validate:overlay:regressions": "npx tsx team-scrape/draft-picks/scripts/pst/pst_validate_owner_overlay_regressions.ts",
    "pst:entitlements": "npx tsx team-scrape/draft-picks/scripts/pst/pst_phase_8_build_entitlement_assets.ts",
    "pst:push:base-entitlements": "npx tsx team-scrape/draft-picks/scripts/pst/pst_phase_10_push_base_entitlements.ts",
    "pst:patch:base-teams-entitlements": "npx tsx team-scrape/draft-picks/scripts/pst/pst_phase_10_patch_base_teams_entitlements.ts",
    "pst:push:base-pick-rules": "npx tsx team-scrape/draft-picks/scripts/pst/pst_phase_12_3a_push_base_pick_rules.ts",
    "pst:audit:hou:2026:r2": "npx tsx team-scrape/draft-picks/scripts/pst/pst_audit_hou_2026_r2.ts",
    "pst:audit:hou:entitlements": "npx tsx team-scrape/draft-picks/scripts/pst/pst_audit_hou_entitlements_sanity.ts",
    "pst:audit:entitlements:all": "npx tsx team-scrape/draft-picks/scripts/pst/pst_audit_all_teams_entitlements_sanity.ts",
    "pst:guard:entitlements:sanity": "npx tsx team-scrape/draft-picks/scripts/pst/pst_audit_all_teams_entitlements_sanity.ts",
    "pst:trace:hou:2026:r2": "npx tsx team-scrape/draft-picks/scripts/pst/pst_trace_owner_overlay_anomalies.ts",
    "ci:phase69-proof": "node scripts/ci/run_phase69_tpe_migration_proof.js",
    "ci:phase80-cap-proof": "node scripts/ci/run_phase80_cap_sheet_e2e_proof.js",
    "ci:phaseD2-dare-gate": "node scripts/ci/run_phaseD2_true_e2e_trade_to_advance_gate.js",
    "ci:phaseD3-dare-gate": "vitest run --config vitest.config.js src/tests/architect/dare/phaseD3_true_e2e_gate.integration.test.js",
    "ci:phaseD4-dare-emulator-gate": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8082 vitest run --config vitest.emulator.config.js src/tests/architect/dare/phaseD4_true_e2e_emulator_gate.emulator.test.ts",
    "verify:draft-assets": "vitest run --config vitest.config.js src/tests/architect/dare src/tests/architect/phaseC_entitlement_invariants_integration.test.ts",
    "verify:draft-assets:emu": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8082 vitest run --config vitest.emulator.config.js src/tests/architect/dare/phaseD4_true_e2e_emulator_gate.emulator.test.ts",
    "verify:legacy:phaseD2": "npm run ci:phaseD2-dare-gate",
    "verify:legacy:phaseD3": "npm run ci:phaseD3-dare-gate",
    "verify:legacy:phaseD4": "npm run ci:phaseD4-dare-emulator-gate",
    "pipeline:sync:plan": "npx tsx scripts/release/scouting_prod_sync_plan.ts",
    "pipeline:sync:verify": "npx tsx scripts/release/scouting_prod_sync_plan.ts --verify-only",
    "pipeline:stage:players": "npx tsx player-scrape/firestore_staging/scripts/stage_all_players.ts",
    "pipeline:stage:teams:patch": "npm run stage:patch:baseTeams:entitlementIds:write",
    "pipeline:verify:artifacts": "npm run verify:artifacts:players && npm run verify:artifacts:baseTeams",
    "pipeline:prod:push:players": "echo 'Run: npx tsx player-scrape/firestore_staging/scripts/push_staged_players.ts --confirmProject=scoutzero-bf1ae'",
    "pipeline:prod:push:teams": "echo 'Run: npx tsx team-scrape/shared/firestore_staging/scripts/push_staged_teams.ts --confirmProject=scoutzero-bf1ae'",
    "pipeline:prod:push:pst": "echo 'Run entitlements, patch, and pick-rules scripts with emulator env UNSET. See: npm run pipeline:sync:plan'"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.6",
    "@heroicons/react": "^2.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^11.6.1",
    "html-to-image": "^1.11.13",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^0.503.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.5.2",
    "react-router-dom": "^7.6.0",
    "react-window": "^1.8.11",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/react": "^14.2.1",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "c8": "^10.1.3",
    "cheerio": "^1.1.2",
    "csv-parser": "^3.2.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-formatter-table": "^7.32.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "firebase-admin": "^13.5.0",
    "glob": "^11.0.3",
    "got": "^14.5.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "markdownlint-cli": "^0.47.0",
    "playwright": "^1.56.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "puppeteer": "^24.23.0",
    "sharp": "^0.34.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^4.4.0",
    "vitest": "^1.6.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bet-Zero/scoutzero.git"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [],
  "author": "",
