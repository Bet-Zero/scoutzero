#!/usr/bin/env sh

# Generate docs and check if anything changed
npm run docs

# Only add and amend if there are changes
if git diff --quiet docs/; then
  # No changes - exit successfully
  :
else
  echo "Error: Documentation is out of sync. Run 'npm run docs' and commit the changes before pushing."
  exit 1
fi

# Architect cast-ledger gate — scoped to changed architect files only.
# CI is the source of truth; this is a fast local guard against obvious regressions.
# Compares against origin/main; no-op if there are no changed architect files or if
# origin/main is not fetched.
changed_architect_files=$(git diff --name-only --diff-filter=ACMR origin/main...HEAD -- 'src/features/architect/**/*.ts' 'src/features/architect/**/*.tsx' 2>/dev/null || true)
if [ -n "$changed_architect_files" ]; then
  echo "$changed_architect_files" | xargs -r npx eslint --no-error-on-unmatched-pattern || {
    echo "Error: Architect ESLint check failed on changed files. See docs/architect/ARCHITECT_TYPE_CAST_LEDGER.md for the new-exception protocol."
    exit 1
  }
fi
