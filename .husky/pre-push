#!/usr/bin/env sh

# Generate docs and check if anything changed
npm run docs

# Only add and amend if there are changes
if git diff --quiet docs/; then
  # No changes - exit successfully
  :
else
  echo "Error: Documentation is out of sync. Run 'npm run docs' and commit the changes before pushing."
  exit 1
fi

# Architect cast-ledger gate — runs the same count-based baseline check as CI.
# Only fails if per-file cast-violation counts INCREASE vs .architect-cast-baseline.json.
# Pre-existing violations in touched files do not cause failure (consistent with CI).
changed_architect_files=$(git diff --name-only --diff-filter=ACMR origin/main...HEAD -- 'src/features/architect/**/*.ts' 'src/features/architect/**/*.tsx' 2>/dev/null || true)
if [ -n "$changed_architect_files" ]; then
  node scripts/architect-cast-gate.mjs || {
    echo "Error: Architect cast-gate failed. Violation counts increased vs baseline. See docs/architect/ARCHITECT_TYPE_CAST_LEDGER.md for the new-exception protocol."
    exit 1
  }
fi
